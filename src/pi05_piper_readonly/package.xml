<?xml version="1.0"?>
<package format="3">
  <name>pi05_piper_readonly</name>
  <version>0.1.0</version>
  <description>Receive-only four-arm Piper state and diagnostics for Pi05.</description>
  <maintainer email="maintainer@example.com">Pi05 Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
